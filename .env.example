# Wiki.js + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest lives in
# the compose file's `x-images` block, so `git pull` delivers the versions
# this repository has tested. To pin differently, uncomment:
# WIKIJS_IMAGE_TAG=requarks/wiki:2.5.314@sha256:…
# WIKIJS_POSTGRES_IMAGE_TAG=postgres:14.24@sha256:…
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…

# Traefik Variables
# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# The email address used by Let's Encrypt for renewal notices.
# REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# The hostname of the Traefik dashboard (DNS must point at this server).
# REQUIRED.
TRAEFIK_HOSTNAME=traefik.wikijs.example.com

# Basic auth for the Traefik dashboard.
# REQUIRED. Generate your own (replace the username and password):
#     htpasswd -nB traefikadmin
# or with Docker, no local htpasswd needed:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin your-password
# Escape every `$` in the hash as `$$` when pasting into this file.
TRAEFIK_BASIC_AUTH=

# Wiki.js Variables
# The hostname the wiki is served on (DNS must point at this server).
# REQUIRED.
WIKIJS_HOSTNAME=wikijs.example.com

# PostgreSQL password for the Wiki.js database.
# REQUIRED. Generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
WIKIJS_DB_PASSWORD=

# Database name and user. Defaults shown; the restore script assumes
# these defaults, adjust it if you change them.
# WIKIJS_DB_NAME=wikijsdb
# WIKIJS_DB_USER=wikijsdbuser

# Backup Variables (defaults shown)
# Delay before the first backup after the stack starts.
# BACKUP_INIT_SLEEP=30m
# Interval between backups.
# BACKUP_INTERVAL=24h
# Delete backups older than this many days.
# POSTGRES_BACKUP_PRUNE_DAYS=7
# Path inside the backups container where dumps are written.
# POSTGRES_BACKUPS_PATH=/srv/wikijs-postgres/backups
# Filename prefix for the dumps.
# POSTGRES_BACKUP_NAME=wikijs-postgres-backup

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# WIKIJS_POSTGRES_MEMORY_LIMIT=1g
# WIKIJS_POSTGRES_CPU_LIMIT=1.0
# WIKIJS_POSTGRES_MEMORY_RESERVATION=128m
# WIKIJS_POSTGRES_CPU_RESERVATION=0.25
# WIKIJS_MEMORY_LIMIT=512m
# WIKIJS_CPU_LIMIT=1.0
# WIKIJS_MEMORY_RESERVATION=64m
# WIKIJS_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# WIKIJS_BACKUPS_MEMORY_LIMIT=256m
# WIKIJS_BACKUPS_CPU_LIMIT=0.5
# WIKIJS_BACKUPS_MEMORY_RESERVATION=32m
# WIKIJS_BACKUPS_CPU_RESERVATION=0.1
